# ==============================================================================
# Enterprise RAG Ingestion Pipeline - Docker Environment Variables
# ==============================================================================

# Port to expose on the host machine (default: 8082 to avoid conflict with local dev ports)
RAG_PORT=8082

# Optional Google Gemini API Key for LLM Question Answering
# If not provided, the pipeline falls back to local Ollama (http://localhost:11434) or Extractive summary
RAG_LLM_GEMINI_API_KEY=

# Internal ChromaDB URL inside Docker network
CHROMA_URL=http://chromadb:8000
